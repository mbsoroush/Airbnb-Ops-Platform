# Copy to .env (gitignored). The CLI loads it automatically and docker compose reads it too.
# Real environment variables always win over values in this file.

# --- Database (defaults already match docker-compose; leave commented unless you change them)
# If you change the password, set it BEFORE the first `make db-up`: an existing volume keeps
# the password it was created with.
# AIRBNB_DB_HOST=localhost
# AIRBNB_DB_PORT=5432
# AIRBNB_DB_NAME=airbnb
# AIRBNB_DB_USER=airbnb
# AIRBNB_DB_PASSWORD=airbnb
# AIRBNB_PII_SALT=airbnb-ops

# --- Feature dataset. Version string used in the output file names.
# AIRBNB_FEATURE_VERSION=v1

# --- Experiment tracking (stage 5). Local MLflow server from `make mlflow-up`.
# Host port 5001 because macOS uses 5000 for AirPlay Receiver. A remote server (and its
# credentials, MLFLOW_TRACKING_USERNAME / MLFLOW_TRACKING_PASSWORD) can be set here or in the
# shell; never commit them.
# MLFLOW_HOST_PORT=5001
# MLFLOW_TRACKING_URI=http://localhost:5001
# MLFLOW_EXPERIMENT_NAME=airbnb_high_demand_proxy
# MLFLOW_VERSION=2.20.3

# --- BI layer (needed for `make bi-setup`)
# Use long random values, e.g. `openssl rand -hex 16`. Metabase rejects common passwords.
# Read-only Postgres role that Metabase connects with (can only read the analytics schema).
AIRBNB_READER_USER=metabase_reader
AIRBNB_READER_PASSWORD=
# First Metabase admin account, created on first run.
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=
# METABASE_VERSION=v0.65.6

# --- Orchestration (needed for `make af-up`)
# Password for the Airflow web UI user "admin" (dev-only SimpleAuthManager).
AIRFLOW_ADMIN_PASSWORD=
# AIRFLOW_VERSION=3.4.0
